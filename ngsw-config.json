{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "tf-model-weights",
      "urls": [
        "/api/workflow-ai/static/models/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 30,
        "maxAge": "30d",
        "timeout": "60s"
      }
    },
    {
      "name": "tf-offline-data",
      "urls": [
        "/api/workflow-ai/models/offline-data"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 5,
        "maxAge": "1h",
        "timeout": "15s"
      }
    },
    {
      "name": "tf-predictions",
      "urls": [
        "/api/workflow-ai/nlp/predict-delay/**",
        "/api/workflow-ai/nlp/predict-bottleneck/**",
        "/api/workflow-ai/nlp/rank-priority-real/**",
        "/api/workflow-ai/nlp/detect-anomalies/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "10m",
        "timeout": "10s"
      }
    },
    {
      "name": "api-core",
      "urls": [
        "/api/workflows",
        "/api/workflows/**",
        "/api/departments/**",
        "/api/users/**",
        "/api/tramites/**",
        "/api/activities/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 500,
        "maxAge": "30m",
        "timeout": "10s"
      }
    },
    {
      "name": "tf-nlp-static",
      "urls": [
        "/api/workflow-ai/nlp/workflow-requirements"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 10,
        "maxAge": "1h",
        "timeout": "10s"
      }
    }
  ]
}
